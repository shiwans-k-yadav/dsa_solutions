//platform: GFG 
class Solution {
  public:
    stack<int> insertAtBottom(stack<int> st, int x) {
        stack<int> S;
        int n =st.size();
        for(int i=0;i<n;i++){
            S.push(st.top());
            st.pop();
        }
        S.push(x);
        int m = S.size();
        for(int i=0;i<m;i++){
            st.push(S.top());
            S.pop();
        }
        return st;
    }
};
